{
  "name": "magic-keyframe",
  "version": "0.2.0",
  "private": true,
  "description": "A focused wedding video editor for Byrne Photography.",
  "author": "Byrne Photography",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run prepare:desktop && npm run build && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run prepare:desktop && npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --dir",
    "verify:media": "npm run build && node scripts/verify-export.cjs",
    "prepare:desktop": "node scripts/prepare-desktop.cjs",
    "start": "npm run prepare:desktop && npm run build && electron .",
    "package:portable": "npm run prepare:desktop && npm run build && electron-builder --win zip --config.win.signAndEditExecutable=false",
    "associate:projects": "npm run prepare:desktop && npm run build && node scripts/associate-projects.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.byrnephotography.magickey",
    "productName": "Magic Keyframe",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "assets/ffmpeg-win64.exe"
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "node_modules/**",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/ffmpeg.exe*",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Magic-Keyframe-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Magic-Keyframe-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "mkproj",
        "name": "Magic Keyframe Project",
        "description": "Magic Keyframe editing project",
        "role": "Editor",
        "mimeType": "application/x-magic-keyframe-project"
      }
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
